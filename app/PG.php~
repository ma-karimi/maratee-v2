<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Model;

/**
 * @property int $id
 * @property mixed $era
 * @property mixed $period
 * @property mixed $epoch
 * @property mixed $stage
 * @property string $created_at
 * @property string $updated_at
 * @property string $deleted_at
 * @property Paleontology[] $paleontologies
 */
class PG extends Model
{
    /**
     * The table associated with the model.
     * 
     * @var string
     */
    protected $table = 'geology_ages';

    /**
     * @var array
     */
    protected $fillable = ['era', 'period', 'epoch', 'stage', 'created_at', 'updated_at', 'deleted_at'];

    /**
     * The storage format of the model's date columns.
     * 
     * @var string
     */
    protected $dateFormat = 'U';

    /**
     * @return \Illuminate\Database\Eloquent\Relations\HasMany
     */
    public function paleontologies()
    {
        return $this->hasMany('App\Models\Paleontology');
    }
}
