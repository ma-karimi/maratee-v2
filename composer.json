{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "aws/aws-sdk-php": "^3.199",
        "darkaonline/l5-swagger": "8.0.7",
        "felixkiss/uniquewith-validator": "3.4.2",
        "fideloper/proxy": "^4.0",
        "fruitcake/laravel-cors": "2.0.4",
        "genealabs/laravel-model-caching": "*",
        "grimzy/laravel-mysql-spatial": "^5.0",
        "infyomlabs/adminlte-templates": "3.0.3",
        "infyomlabs/laravel-generator": "3.1.1",
        "infyomlabs/swagger-generator": "dev-master",
        "jedrzej/searchable": "0.0.17",
        "kalnoy/nestedset": "6.0.0",
        "krlove/eloquent-model-generator": "^1.3",
        "laravel/framework": "^8.12",
        "laravel/horizon": "^5.7",
        "laravel/octane": "^1.1",
        "laravel/passport": "10.1.3",
        "laravel/telescope": "4.6.5",
        "laravel/tinker": "2.6.2",
        "laravel/ui": "^3.3",
        "laravelcollective/html": "6.2.1",
        "league/geotools": "0.8.3",
        "maatwebsite/excel": "3.1.33",
        "mews/captcha": "3.2.6",
        "mstaack/laravel-postgis": "5.2",
        "orangehill/iseed": "3.0.1",
        "owen-it/laravel-auditing": "12.0.0",
        "pragmarx/countries": "0.7.2",
        "predis/predis": "^1.1",
        "react/promise": "2.8.0",
        "spatie/laravel-medialibrary": "^9.0.0",
        "spatie/laravel-permission": "5.1.1",
        "spiral/roadrunner": "^2.0",
        "vkovic/laravel-custom-casts": "1.3.1",
        "zircote/swagger-php": "3.2.3"
    },
    "require-dev": {
        "beyondcode/laravel-dump-server": "^1.0",
        "filp/whoops": "^2.0",
        "laravel/sail": "^1.12",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^5.0",
        "nunomaduro/phpinsights": "2.0.1",
        "phpunit/phpunit": "^9.3.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "disable-tls": true,
        "secure-http": false,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeds/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "files": [
            "app/Libraries/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
